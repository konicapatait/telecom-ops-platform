/**
 * @file <%= label %> capability component, exposed as './<%= exposedName %>'.
 */
import { ChangeDetectionStrategy, Component, input } from '@angular/core';
import { DsEmptyState } from '@org/design-system';
import type { CaseType } from '@platform/contracts';

/**
 * Exposed as './<%= exposedName %>'. Inputs follow CaseCapabilityInputs (@platform/contracts):
 * the tab host passes caseId + caseType and nothing else. Fetch your own data; never read the route.
 */
@Component({
  selector: '<%= prefix %>-<%= fileName %>',
  imports: [DsEmptyState],
  changeDetection: ChangeDetectionStrategy.OnPush,
  template: `
    <section class="cap" [attr.aria-label]="'<%= label %> for case ' + caseId()">
      <p class="cap__meta">Case <code>{{ caseId() }}</code> · {{ caseType() }}</p>
      <ds-empty-state icon="info" heading="<%= label %>" message="Generated by @platform/tools:mfe. Build this capability here." />
    </section>
  `,
  styles: `.cap__meta { color: var(--ds-color-text-muted); font-size: var(--ds-font-size-sm); }`,
})
export class <%= className %>Component {
  readonly caseId = input.required<string>();
  readonly caseType = input.required<CaseType>();
}

export default <%= className %>Component;
