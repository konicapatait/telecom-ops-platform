/**
 * @file <%= label %> case screen, as data: the four standard case tabs and the domain's decision codes (ADR-0005, ADR-0023).
 */
import type { CaseDomainConfig } from '@platform/contracts';

/**
 * <%= label %> case screen, as data (ADR-0005). Adding or removing a tab is a change HERE, never in the layout.
 * Generated with the standard four case tabs (ADR-0023).
 */
export const <%= constName %>_DOMAIN_CONFIG: CaseDomainConfig = {
  domain: '<%= caseDomain %>',
  title: '<%= label %> case',
  queueTitle: '<%= label %>',
  // ADR-0023: every case screen has the same four tabs (Case decision · Triggering info · Audit log · Attachments).
  tabs: [
    { id: 'triggering', label: 'Triggering info', remote: '<%= projectName %>', exposedModule: './<%= className %>Overview', order: 1 },
    { id: 'audit', label: 'Audit log', remote: 'mfe-cap-audit-trail', exposedModule: './AuditTrail', order: 2, entitlement: 'case:audit:view' },
    {
      id: 'attachments',
      label: 'Attachments',
      remote: 'mfe-cap-attachments',
      exposedModule: './Attachments',
      order: 3,
      entitlement: 'case:attachments:view',
    },
  ],
  // Shown as the FIRST tab. No entitlement: anyone who can see the case sees its decision; recording one needs case:resolve.
  resolution: { id: 'decision', label: 'Case decision', remote: 'mfe-cap-case-resolution', exposedModule: './CaseResolution', order: 0 },
  // TODO: agree the domain's codes with the backend (it validates them).
  resolutionCodes: [{ code: '<%= caseDomain %>_RESOLVED', label: 'Resolved', requiresNote: false }],
};
