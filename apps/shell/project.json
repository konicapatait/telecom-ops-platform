{
  "name": "shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "shell",
  "sourceRoot": "apps/shell/src",
  "tags": ["type:app", "family:host", "kind:host"],
  "targets": {
    "build": {
      "executor": "@angular-architects/native-federation:build",
      "outputs": ["{workspaceRoot}/dist/apps/shell", "{workspaceRoot}/dist/apps-mock/shell"],
      "options": {},
      "configurations": {
        "production": {
          "target": "shell:esbuild:production"
        },
        "mock": {
          "target": "shell:esbuild:mock"
        },
        "development": {
          "target": "shell:esbuild:development",
          "dev": true
        }
      },
      "defaultConfiguration": "production"
    },
    "esbuild": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/shell",
        "index": "apps/shell/src/index.html",
        "browser": "apps/shell/src/main.ts",
        "polyfills": ["es-module-shims"],
        "tsConfig": "apps/shell/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/shell/public"
          }
        ],
        "styles": [
          "node_modules/@org/design-tokens/tokens.css",
          "node_modules/@org/design-tokens/reset.css",
          "apps/shell/src/styles.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "800kb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/shell/src/environments/environment.ts",
              "with": "apps/shell/src/environments/environment.prod.ts"
            },
            {
              "replace": "apps/shell/src/start-mocks.ts",
              "with": "apps/shell/src/start-mocks.prod.ts"
            }
          ]
        },
        "mock": {
          "outputPath": "dist/apps-mock/shell",
          "outputHashing": "all",
          "assets": [
            {
              "glob": "**/*",
              "input": "apps/shell/public"
            },
            {
              "glob": "mockServiceWorker.js",
              "input": "libs/mocks/assets",
              "output": "/"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/shell/src/environments/environment.ts",
              "with": "apps/shell/src/environments/environment.mock.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "assets": [
            {
              "glob": "**/*",
              "input": "apps/shell/public"
            },
            {
              "glob": "mockServiceWorker.js",
              "input": "libs/mocks/assets",
              "output": "/"
            },
            {
              "glob": "mf-manifest.json",
              "input": "libs/mf-manifest/manifests/local",
              "output": "/"
            },
            {
              "glob": "app-config.json",
              "input": "apps/shell/config/local",
              "output": "/"
            }
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-architects/native-federation:build",
      "continuous": true,
      "options": {
        "target": "shell:serve-original:development",
        "rebuildDelay": 500,
        "dev": true,
        "cacheExternalArtifacts": false,
        "port": 0
      }
    },
    "serve-original": {
      "executor": "@angular/build:dev-server",
      "continuous": true,
      "options": {
        "port": 4200
      },
      "configurations": {
        "production": {
          "buildTarget": "shell:esbuild:production"
        },
        "development": {
          "buildTarget": "shell:esbuild:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "continuous": true,
      "options": {
        "buildTarget": "shell:build",
        "staticFilePath": "dist/apps/shell/browser",
        "port": 4200,
        "spa": true
      }
    }
  }
}
