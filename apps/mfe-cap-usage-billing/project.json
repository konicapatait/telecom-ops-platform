{
  "name": "mfe-cap-usage-billing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/mfe-cap-usage-billing/src",
  "prefix": "usagebilling",
  "tags": ["type:app", "family:capability", "kind:capability"],
  "targets": {
    "build": {
      "executor": "@angular-architects/native-federation:build",
      "outputs": [
        "{workspaceRoot}/dist/apps/mfe-cap-usage-billing",
        "{workspaceRoot}/dist/apps-mock/mfe-cap-usage-billing"
      ],
      "options": {},
      "configurations": {
        "production": {
          "target": "mfe-cap-usage-billing:esbuild:production"
        },
        "mock": {
          "target": "mfe-cap-usage-billing:esbuild:mock"
        },
        "development": {
          "target": "mfe-cap-usage-billing:esbuild:development",
          "dev": true
        }
      },
      "defaultConfiguration": "production"
    },
    "esbuild": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/mfe-cap-usage-billing",
        "index": "apps/mfe-cap-usage-billing/src/index.html",
        "browser": "apps/mfe-cap-usage-billing/src/main.ts",
        "polyfills": ["es-module-shims"],
        "tsConfig": "apps/mfe-cap-usage-billing/tsconfig.app.json",
        "assets": [],
        "styles": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "anyScript",
              "maximumWarning": "150kb",
              "maximumError": "300kb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/mfe-cap-usage-billing/src/environments/environment.ts",
              "with": "apps/mfe-cap-usage-billing/src/environments/environment.prod.ts"
            },
            {
              "replace": "apps/mfe-cap-usage-billing/src/start-mocks.ts",
              "with": "apps/mfe-cap-usage-billing/src/start-mocks.prod.ts"
            }
          ]
        },
        "mock": {
          "outputPath": "dist/apps-mock/mfe-cap-usage-billing",
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/mfe-cap-usage-billing/src/environments/environment.ts",
              "with": "apps/mfe-cap-usage-billing/src/environments/environment.mock.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "assets": [
            {
              "glob": "mockServiceWorker.js",
              "input": "libs/mocks/assets",
              "output": "/"
            }
          ],
          "styles": ["node_modules/@org/design-tokens/tokens.css", "node_modules/@org/design-tokens/reset.css"]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-architects/native-federation:build",
      "continuous": true,
      "options": {
        "target": "mfe-cap-usage-billing:serve-original:development",
        "rebuildDelay": 500,
        "dev": true,
        "cacheExternalArtifacts": false,
        "port": 0
      }
    },
    "serve-original": {
      "executor": "@angular/build:dev-server",
      "continuous": true,
      "options": {
        "port": 4203
      },
      "configurations": {
        "production": {
          "buildTarget": "mfe-cap-usage-billing:esbuild:production"
        },
        "development": {
          "buildTarget": "mfe-cap-usage-billing:esbuild:development"
        }
      },
      "defaultConfiguration": "development"
    }
  }
}
